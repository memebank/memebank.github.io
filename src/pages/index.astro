---
const features = [
  ["Image-first catalog", "Import screenshots, memes, reactions, and reusable visual assets into a durable, deduplicated library."],
  ["Search by meaning", "Combine OCR text, captions, tags, full-text ranking, and embeddings so recall does not depend on filenames."],
  ["Portable storage", "Keep metadata coherent while originals can live in S3, R2, Google Drive, iCloud, OneDrive, or another user-owned adapter."],
  ["Async enrichment", "Queue OCR and vision work behind explicit job state, reviewable outputs, and privacy-aware decryption boundaries."],
  ["Cross-platform capture", "Flutter mobile and desktop applications make save, preview, copy, share, and offline browsing native interactions."],
  ["ClipTown interop", "Clipboard workflows integrate through versioned APIs and SDKs rather than coupling databases or encryption internals."],
];

const samples = [
  {
    id: "ts",
    label: "TypeScript API preview",
    file: "import.ts",
    code: `const created = await fetch(baseUrl + "/v1/assets", {
  method: "POST",
  headers: {
    authorization: "Bearer " + accessToken,
    "content-type": "application/json",
  },
  body: JSON.stringify({
    source: "clipboard",
    objectRef: uploadedObjectRef,
    enrich: ["ocr", "caption", "tags", "embedding"],
  }),
}).then((response) => response.json());

console.log(created.assetId, created.enrichmentState);`,
    note: "Illustrative API shape from the planned catalog/enrichment boundary; no public TypeScript SDK is released yet.",
  },
  {
    id: "python",
    label: "Python API preview",
    file: "search.py",
    code: `response = requests.post(
    f"{base_url}/v1/search",
    headers={"authorization": f"Bearer {access_token}"},
    json={
        "query": "that surprised pikachu reaction",
        "modes": ["full_text", "vector", "ocr"],
        "limit": 24,
    },
    timeout=20,
)
response.raise_for_status()
for hit in response.json()["results"]:
    print(hit["assetId"], hit["score"])`,
    note: "Search preview combines lexical and semantic recall while returning stable asset references.",
  },
  {
    id: "curl",
    label: "curl upload flow",
    file: "upload.sh",
    code: `# 1. Request a bounded upload target
curl -X POST "$BASE_URL/v1/uploads" \
  -H "authorization: Bearer $ACCESS_TOKEN" \
  -H "content-type: application/json" \
  --data '{"contentType":"image/png","size":482190}'

# 2. Upload bytes directly to the returned object target
# 3. Create the catalog asset from the opaque object reference`,
    note: "The intended flow keeps large bytes off the catalog API and creates metadata only after a bounded upload.",
  },
  {
    id: "job",
    label: "Enrichment job JSON",
    file: "enrichment.json",
    code: `{
  "assetId": "asset_01J...",
  "requested": ["ocr", "caption", "tags", "embedding"],
  "policy": {
    "serverSideDecryptApproved": true,
    "retainDerivedText": true,
    "retainPlaintextOriginal": false
  },
  "state": "queued"
}`,
    note: "A reviewable job document makes asynchronous analysis and plaintext-retention choices explicit.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="A cross-platform, searchable library for memes and reusable visual assets." />
    <meta name="theme-color" content="#170b2d" />
    <title>MemeBank — remember every image</title>
  </head>
  <body>
    <header class="fleet-nav-enhanced">
      <a class="brand" href="/"><b>MB</b><span>MemeBank</span></a>
      <nav class="fleet-desktop-nav">
        <a href="#platform">Library</a>
        <a href="#clients">API</a>
        <a href="https://github.com/memebank">GitHub ↗</a>
      <a href="#access">Access</a><a href="https://user.memebank.github.io/">Log in</a><a href="https://auth.memebank.github.io/">Sign up</a></nav><details class="fleet-mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="#access">Access</a><a href="https://user.memebank.github.io/">User log in</a><a href="https://org.memebank.github.io/">Organization access</a><a href="https://auth.memebank.github.io/">Sign up</a><a href="https://github.com/memebank">Source</a></nav></details>
    </header>

    <main>
      <section class="hero">
        <div>
          <p class="eyebrow">Image memory · Cross-platform</p>
          <h1>Save the image. <em>Find the meaning later.</em></h1>
          <p class="lede">MemeBank turns scattered screenshots and visual references into a portable catalog enriched by OCR, captions, tags, and embeddings—ready to search, copy, share, and sync across devices.</p>
          <div class="actions">
            <a class="primary" href="https://github.com/memebank">Explore the project ↗</a>
            <a href="#clients">See the API preview</a>
          </div>
          <ul>
            <li>OCR + semantic search</li>
            <li>Portable object storage</li>
            <li>Flutter mobile + desktop</li>
          </ul>
        </div>
        <div class="visual" aria-label="A searchable visual memory bank">
          <span class="grid"></span>
          <div class="card one">WHEN THE BUILD<br /><b>PASSES LOCALLY</b></div>
          <div class="card two">SEARCH<br /><b>“surprised reaction”</b></div>
          <div class="card three">OCR · TAGS · VECTOR<br /><b>indexed</b></div>
          <div class="core"><small>MEMORY BANK</small><strong>24,810 assets</strong><i>meaning over filenames</i></div>
        </div>
      </section>

      <section class="metrics">
        <div><b>5+</b><span>storage adapters planned</span></div>
        <div><b>4</b><span>enrichment modes</span></div>
        <div><b>2</b><span>search families</span></div>
        <div><b>1</b><span>portable catalog</span></div>
      </section>

      <section id="platform" class="platform">
        <p class="eyebrow">A visual memory layer</p>
        <h2>Your image library should understand more than folders.</h2>
        <p class="intro">Catalog metadata, original bytes, derived text, embeddings, encryption policy, and clipboard interoperability remain explicit layers. That separation makes enrichment useful without making one storage provider or one application the owner of everything.</p>
        <div class="features">
          {features.map(([title, body], index) => (
            <article>
              <small>{String(index + 1).padStart(2, "0")}</small>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="clients" class="sdk" data-sdk>
        <div>
          <p class="eyebrow">API preview</p>
          <h2>Design the client surface around stable assets and explicit jobs.</h2>
          <p class="intro">A public <code>memebank-clients</code> repository does not exist yet. These examples document the intended HTTP boundaries and are labeled as previews rather than released SDKs.</p>
          <a class="source" href="https://github.com/memebank">Follow the implementation ↗</a>
        </div>
        <div class="workbench">
          <div class="toolbar">
            <label>
              <span>Example</span>
              <select aria-label="Select client language" data-language>
                {samples.map((sample, index) => <option value={sample.id} selected={index === 0}>{sample.label}</option>)}
              </select>
            </label>
            <code data-file>{samples[0]?.file ?? "import.ts"}</code>
            <button data-copy type="button">Copy</button>
          </div>
          {samples.map((sample, index) => (
            <article data-sample={sample.id} data-name={sample.file} hidden={index !== 0}>
              <pre tabindex="0"><code>{sample.code}</code></pre>
              <p>{sample.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="closing">
        <p class="eyebrow">Memes are a concurrency</p>
        <h2>Keep every visual idea ready for the moment it matters.</h2>
        <p>Use MemeBank as the durable visual library and connect clipboard workflows through <a href="https://github.com/cliptown">ClipTown</a> APIs rather than shared internals.</p>
        <a class="closing-action" href="https://github.com/memebank">Open the organization ↗</a>
      </section>

<section class="fleet-access" id="access" aria-labelledby="fleet-access-title"><div class="fleet-access-head"><p class="fleet-access-kicker">Product access</p><h2 id="fleet-access-title">Public context here. Account work in the right application.</h2><p class="fleet-access-intro">MemeBank's marketing site remains public. Authenticated media libraries, saved context, and team collections is separated into individual, organization, and account-creation boundaries.</p></div><div class="fleet-access-grid"><article><span>INDIVIDUAL</span><h3>Your workspace</h3><p>Return to personal activity, saved context, and work owned by your account.</p><a href="https://user.memebank.github.io/">User log in ↗</a></article><article><span>ORGANIZATION</span><h3>Team operations</h3><p>Open shared membership, policy, and organization-scoped work.</p><a href="https://org.memebank.github.io/">Organization access ↗</a></article><article><span>SHARED AUTH</span><h3>Create an account</h3><p>Start through the dedicated authentication boundary before entering the product.</p><a href="https://auth.memebank.github.io/">Sign up ↗</a></article></div></section>
</main>

    <footer>
      <span>© 2026 MemeBank</span>
      <a href="https://github.com/cliptown">ClipTown interop</a>
      <a href="https://github.com/memebank">Source</a>
    </footer>

    <script is:inline>
      document.querySelectorAll('[data-sdk]').forEach((root) => {
        const select = root.querySelector('[data-language]');
        const file = root.querySelector('[data-file]');
        const copy = root.querySelector('[data-copy]');
        const panels = [...root.querySelectorAll('[data-sample]')];
        const show = (id) => panels.forEach((panel) => {
          const active = panel.dataset.sample === id;
          panel.hidden = !active;
          if (active) file.textContent = panel.dataset.name || '';
        });
        select?.addEventListener('change', (event) => show(event.target.value));
        copy?.addEventListener('click', async () => {
          const active = panels.find((panel) => !panel.hidden);
          const text = active?.querySelector('code')?.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            copy.textContent = 'Copied';
          } catch {
            active?.querySelector('pre')?.focus();
            copy.textContent = 'Select code';
          }
          setTimeout(() => copy.textContent = 'Copy', 1200);
        });
      });
    </script>

    <style>
      :root{--accent:#db2777;--hot:#8b5cf6;--ink:#170b2d;--muted:#6b6478;--paper:#fff7fb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#fdf2f8,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--ink);color:white;font-size:.7rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:47rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing-action{padding:.75rem 1rem;border:1px solid #0f172a1b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 50%,#db27774b,transparent 39%),linear-gradient(145deg,#180b29,#2e1648);box-shadow:0 35px 90px #4a133d45}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:2.4rem 2.4rem}.card,.core{position:absolute;border:1px solid #ffffff25;border-radius:1rem;background:#1f1234df;color:#f9a8d4;box-shadow:0 18px 40px #0005;backdrop-filter:blur(12px)}.card{padding:1rem;font:750 .68rem/1.45 ui-monospace,monospace;transform:rotate(-4deg)}.card b,.core strong{color:white}.one{top:10%;left:7%}.two{top:14%;right:6%;transform:rotate(4deg)}.three{bottom:9%;right:9%;transform:rotate(-2deg)}.core{top:53%;left:43%;display:grid;width:14rem;padding:1.25rem;transform:translate(-50%,-50%)}.core small{font:800 .64rem/1 ui-monospace,monospace;letter-spacing:.1em}.core strong{font-size:1.35rem}.core i{color:#c4b5fd;font-style:normal;font-size:.78rem}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #35114818;border-radius:1.15rem;background:#ffffffc9}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #35114818}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #35114814;border-radius:1.1rem;background:#ffffffc5}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#160b29;color:#fce7f3;box-shadow:0 32px 90px #35114840}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#21113a}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#c4b5fd;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#2e1648;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#c4b5fd;font-size:.75rem}.workbench pre{overflow:auto;min-height:22rem;max-height:30rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#c4b5fd;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),var(--hot));color:white}.closing .eyebrow{color:#ffffffc7}.closing p{max-width:48rem}.closing-action{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </body>
</html>

<style>
  .fleet-nav-enhanced { position: sticky !important; top: 0; z-index: 200; isolation: isolate; }
  .fleet-mobile-nav { display: none; position: relative; margin-left: auto; }
  .fleet-mobile-nav summary { cursor: pointer; list-style: none; padding: .62rem .8rem; border: 1px solid currentColor; border-radius: .45rem; font: 700 .72rem/1 system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .fleet-mobile-nav summary::-webkit-details-marker { display: none; }
  .fleet-mobile-nav nav { position: absolute; right: 0; top: calc(100% + .55rem); min-width: 15rem; display: grid; gap: .25rem; padding: .75rem; background: #111827; color: #fff; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 1.4rem 3rem rgba(0,0,0,.3); }
  .fleet-mobile-nav a { padding: .7rem .8rem; color: inherit; text-decoration: none; }
  @media (max-width: 760px) {
    .fleet-desktop-nav { display: none !important; }
    .fleet-mobile-nav { display: block; }
  }
</style>

<style>
  .fleet-access { padding: clamp(3.5rem, 8vw, 7rem) max(4vw, calc((100% - 76rem) / 2)); border-block: 1px solid currentColor; }
  .fleet-access-head { max-width: 48rem; }
  .fleet-access-kicker { margin: 0 0 .8rem; font: 750 .72rem/1.4 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
  .fleet-access h2 { margin: 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 1.02; letter-spacing: -.04em; text-wrap: balance; }
  .fleet-access-intro { max-width: 46rem; margin: 1.25rem 0 0; font-size: 1.05rem; line-height: 1.7; opacity: .78; }
  .fleet-access-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .fleet-access-grid article { padding: 1.5rem; border: 1px solid currentColor; border-radius: .8rem; }
  .fleet-access-grid span { font: 750 .68rem/1 ui-monospace, monospace; letter-spacing: .1em; opacity: .66; }
  .fleet-access-grid h3 { margin: 1.5rem 0 .65rem; font-size: 1.15rem; }
  .fleet-access-grid p { min-height: 4.8rem; margin: 0 0 1.25rem; line-height: 1.55; opacity: .76; }
  .fleet-access-grid a { font-weight: 750; color: inherit; text-underline-offset: .25rem; }
  @media (max-width: 760px) {
    .fleet-access-grid { grid-template-columns: 1fr; }
    .fleet-access-grid p { min-height: 0; }
  }
</style>
